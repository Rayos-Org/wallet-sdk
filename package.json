{
    "license":  "MIT",
    "version":  "0.1.0",
    "type":  "module",
    "bugs":  {
                 "url":  "https://github.com/Rayos-Org/wallet-sdk/issues"
             },
    "keywords":  [
                     "stellar",
                     "wallet",
                     "passkey",
                     "webauthn",
                     "soroban",
                     "sdk",
                     "web3"
                 ],
    "description":  "TypeScript SDK for Guardian Wallet — passkey-secured smart wallets on Stellar",
    "dependencies":  {
                         "zod":  "^4.5.4",
                         "@simplewebauthn/browser":  "^14.0.0",
                         "@stellar/stellar-sdk":  "^17.0.1"
                     },
    "main":  "./dist/index.cjs",
    "devDependencies":  {
                            "@changesets/cli":  "^3.0.2",
                            "@eslint/js":  "^10.0.1",
                            "jsdom":  "^30.0.1",
                            "vitest":  "^5.0.0",
                            "tsup":  "^8.5.1",
                            "@types/node":  "^26.4.1",
                            "eslint":  "^10.10.0",
                            "typescript-eslint":  "^8.69.0",
                            "typescript":  "^5.6.2"
                        },
    "files":  [
                  "dist",
                  "README.md",
                  "CHANGELOG.md",
                  "LICENSE"
              ],
    "exports":  {
                    ".":  {
                              "require":  "./dist/index.cjs",
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "types":  "./dist/index.d.ts",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "author":  "Rayos Org",
    "homepage":  "https://github.com/Rayos-Org/wallet-sdk#readme",
    "name":  "@rayos/wallet-sdk",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/Rayos-Org/wallet-sdk.git"
                   },
    "module":  "./dist/index.js",
    "scripts":  {
                    "version":  "changeset version",
                    "build":  "tsup",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "eslint .",
                    "release":  "pnpm build \u0026\u0026 changeset publish",
                    "changeset":  "changeset",
                    "test":  "vitest run"
                }
}
